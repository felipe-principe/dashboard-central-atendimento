/// Dimensão de hora do dia (0 a 23), gerada no Power Query. Existe para que os heatmaps hora x dia da semana da página de WFM possam cruzar Fato_Chamados e Fato_Abandonos com um eixo e um filtro únicos.
table Dim_Hora
	lineageTag: 371d4766-b484-43be-a86c-b25fb692b5f6

	/// Chave (0 a 23). Relaciona-se com Fato_Chamados e Fato_Abandonos.
	column Hora
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 63c8fac2-5881-435f-bfa4-ee988d513766
		summarizeBy: none
		sourceColumn: Hora

		annotation SummarizationSetBy = Automatic

	/// Rótulo 00:00 a 23:00 para o eixo dos heatmaps.
	column Hora_Label
		dataType: string
		lineageTag: fa153527-4d79-44a0-ac12-f2a04e30b0b9
		summarizeBy: none
		sourceColumn: Hora_Label
		sortByColumn: Hora

		annotation SummarizationSetBy = Automatic

	/// Faixa de turno em que a HORA cai. Diferente de Dim_Agente[Turno], que é o turno em que o agente está escalado: um chamado das 22h atendido por agente da tarde tem Turno_Horario = Noite e Turno = Tarde.
	column Turno_Horario
		dataType: string
		lineageTag: 4b27aa67-7b96-4281-a089-c3a43ee911ee
		summarizeBy: none
		sourceColumn: Turno_Horario
		sortByColumn: Ordem_Turno_Horario

		annotation SummarizationSetBy = Automatic

	column Ordem_Turno_Horario
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a171d8af-c4b4-4167-91e6-34b8afb7a5d4
		summarizeBy: none
		sourceColumn: Ordem_Turno_Horario

		annotation SummarizationSetBy = Automatic

	partition Dim_Hora = m
		mode: import
		source =
				let
				    // Table.FromColumns em vez de Table.FromList + Splitter.SplitByNothing():
				    // o Splitter é feito para texto, e usá-lo com números funciona por acidente.
				    Horas = List.Numbers(0, 24),
				    Tabela = Table.FromColumns({Horas}, {"Hora"}),
				    Tipos = Table.TransformColumnTypes(Tabela, {{"Hora", Int64.Type}}),
				    Rotulo = Table.AddColumn(
				        Tipos,
				        "Hora_Label",
				        each Text.PadStart(Text.From([Hora]), 2, "0") & ":00",
				        type text
				    ),
				    // Faixas conferidas contra a base: os turnos não se sobrepõem.
				    // Manha 06-13 | Tarde 14-21 | Noite 22-05 (vira a meia-noite)
				    Turno = Table.AddColumn(
				        Rotulo,
				        "Turno_Horario",
				        each if [Hora] >= 6 and [Hora] <= 13 then "Manha"
				             else if [Hora] >= 14 and [Hora] <= 21 then "Tarde"
				             else "Noite",
				        type text
				    ),
				    OrdemTurno = Table.AddColumn(
				        Turno,
				        "Ordem_Turno_Horario",
				        each if [Turno_Horario] = "Manha" then 1
				             else if [Turno_Horario] = "Tarde" then 2
				             else 3,
				        Int64.Type
				    )
				in
				    OrdemTurno

	annotation PBI_ResultType = Table

