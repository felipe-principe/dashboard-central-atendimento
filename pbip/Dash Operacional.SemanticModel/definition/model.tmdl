model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Dim_Data","Dim_Canal","Dim_Agente","Dim_Cliente","Dim_Motivo_Contato","Dim_Hora","Fato_Chamados","Fato_Abandonos","Fato_Escala","_Medidas"]

ref table Dim_Data
ref table Dim_Canal
ref table Dim_Agente
ref table Dim_Cliente
ref table Dim_Motivo_Contato
ref table Dim_Hora
ref table Fato_Chamados
ref table Fato_Abandonos
ref table Fato_Escala
ref table _Medidas

ref cultureInfo pt-BR

