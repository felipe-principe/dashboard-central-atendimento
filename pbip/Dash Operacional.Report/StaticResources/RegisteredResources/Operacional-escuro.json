              }
            },
            "backColor": {
              "solid": {
                "color": "#141A26"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8ECF4"
              }
            },
            "backColor": {
              "solid": {
                "color": "#141A26"
              }
            },
            "fontSize": 9
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8ECF4"
              }
            },
            "backColor": {
              "solid": {
                "color": "#141A26"
              }
            },
            "bold": true
          }
