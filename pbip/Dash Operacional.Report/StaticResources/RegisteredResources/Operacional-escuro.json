{
  "name": "Operacional Escuro",
  "dataColors": [
    "#F9F871",
    "#55E1A7",
    "#2A9AC9",
    "#8168DE",
    "#00CDC3",
    "#A8F087",
    "#FF6F91",
    "#FFC75F"
  ],
  "good": "#2E9A70",
  "neutral": "#B5871F",
  "bad": "#E05A4E",
  "maximum": "#2A9AC9",
  "minimum": "#0A0D14",
  "foreground": "#E8ECF4",
  "foregroundNeutralSecondary": "#8B94A8",
  "foregroundNeutralTertiary": "#8B94A8",
  "background": "#0A0D14",
  "backgroundLight": "#141A26",
  "backgroundNeutral": "#232C3D",
  "tableAccent": "#2A9AC9",
  "secondaryBackground": "#232C3D",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "'Segoe UI Light', wf_segoe-ui_light, helvetica, arial, sans-serif",
      "color": "#E8ECF4"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#E8ECF4"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#E8ECF4"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "color": "#8B94A8"
    }
