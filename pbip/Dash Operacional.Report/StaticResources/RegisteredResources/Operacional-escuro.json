        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#8B94A8"
              }
            },
            "fontSize": 9,
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0A0D14"
              }
