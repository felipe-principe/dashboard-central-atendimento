        ]
      }
    },
    "slicers": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#8B94A8"
              }
            },
            "background": {
              "solid": {
                "color": "#141A26"
              }
            },
            "outline": "None"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#1E2636"
              }
            },
            "rowPadding": 3
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8B94A8"
              }
            },
            "backColor": {
              "solid": {
                "color": "#141A26"
              }
            },
            "fontSize": 9,
            "bold": true
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8ECF4"
              }
            },
            "backColor": {
              "solid": {
                "color": "#141A26"
              }
            },
            "fontSize": 9
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#E8ECF4"
              }
            },
            "backColor": {
              "solid": {
                "color": "#141A26"
              }
            },
            "bold": true
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#1E2636"
              }
