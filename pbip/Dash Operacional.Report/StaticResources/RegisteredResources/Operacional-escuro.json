  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#141A26"
              }
            },
            "transparency": 16
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#232C3D"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
            "fontColor": {
              "solid": {
                "color": "#E8ECF4"
              }
            },
            "background": {
              "solid": {
                "color": "#141A26"
              }
            },
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#8B94A8"
              }
            },
            "fontSize": 9,
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "labelColor": {
              "solid": {
                "color": "#8B94A8"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "labelColor": {
              "solid": {
                "color": "#8B94A8"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#1E2636"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "showTitle": false,
            "fontSize": 9,
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "labelColor": {
              "solid": {
                "color": "#8B94A8"
              }
            }
          }
